		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/eslint": "9.6.1",
		"@types/lodash": "4.17.27",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"lodash": "4.18.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"sass": "1.107.1",
		"svelte": "5.57.3",
